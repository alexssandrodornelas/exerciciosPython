#Faça um algoritmo que leia o salário de um funcionário e mostre seu novo salário, com 15% de aumento.

salario = float(input("Digite o valor do salário do funcionário: R$ "))
porcentagem = (salario * 15) / 100
novosalario = salario + porcentagem

print(f"O trabalhador, que ganhava R$ {salario}, com o aumento de 15%, passará a ganhar R$ {novosalario}")
