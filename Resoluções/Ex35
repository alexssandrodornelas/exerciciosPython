#Escreva um programa em Python que leia um número inteiro qualquer e peça para o usuário escolher qual será a base de conversão:
#1 para binário, 2 para octal e 3 para hexadecimal.

import math
num = int(input("Digite um número inteiro, e escolha em qual base você deseja convertê-lo: "))

print("""Escolha uma das bases de conversão:
[1] Binário
[2] Octal
[3] Hexadecimal""")

opcao = int(input("Digite a opção desejada: "))

if opcao == 1:
    print(f"{num} convertido em BINÁRIO é igual à {bin(num)}")
if opcao == 2:
    print(f"{num} convertido em OCTAL é igual à {oct(num)}")
if opcao == 3:
    print(f"{num} Convertido em HEXADECIMAL é igual à {hex(num)}")
else:
    print("Opção inválida, digite a opção correta!")
