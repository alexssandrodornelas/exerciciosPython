#Um professor quer sortear um dos seus quatro alunos para apagar o quadro. Faça um programa que ajude ele, lendo o nome dos alunos e escrevendo na tela o nome do escolhido.

import random
a1 = str(input("Digite o nome do primeiro aluno: "))
a2 = str(input("Digite o nome do segundo aluno: "))
a3 = str(input("Digite o nome do terceito aluno: "))
a4 = str(input("Digite o nome do quarto aluno: "))

# Criando a lista com os alunos.
lista = [a1, a2, a3, a4]

# Escolhendo a função choice, onde ela escolhe o valor em uma lista.
escolhido = random.choice(lista)

print(f"Dentre os alunos {a1}, {a2}, {a3} e {a4}, o aluno escolhido para apagar o quadro foi: {escolhido}")
